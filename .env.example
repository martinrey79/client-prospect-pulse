# xAI / Grok — never commit real keys
XAI_API_KEY=your-key-here
XAI_MODEL=grok-3
XAI_BASE_URL=https://api.x.ai/v1

# LangSmith observability (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=cps-client-prospect-pulse
# Optional: EU / other regions
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# App
CPS_STORE_PATH=data/cps.db
CPS_SIMULATOR_STATE_PATH=data/simulator_state.json
CPS_CHECKPOINT_PATH=data/checkpoints.db
USE_SIMULATOR=true
